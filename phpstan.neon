parameters:
    level: 6
    paths:
        - src
        - tests
        - castor.php
        - .castor/
    scanFiles:
        - .castor.stub.php
    tmpDir: tools/phpstan/var
    inferPrivatePropertyTypeFromConstructor: true

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    typeAliases:
        ContextData: '''
            array{
                project_name: string,
                root_domain: string,
                extra_domains: string[],
                php_version: string,
                docker_compose_files: list<string>,
                docker_compose_run_environment: list<string>,
                macos: bool,
                power_shell: bool,
                user_id: int,
                root_dir: string,
                registry?: ?string,
            }
        '''

    ignoreErrors:
        -
            # Called by Symfony\Component\DependencyInjection\Kernel\KernelTrait via
            # private-method shadowing, not visible to PHPStan's usage analysis.
            message: '#^Method App\\Kernel::getAllowedEnvs\(\) is unused\.$#'
            path: src/Kernel.php
        -
            # Flex-recipe-managed BC guard (symfony/phpunit-bridge), kept as-is so
            # future recipe updates keep applying cleanly.
            message: '#^Call to function method_exists\(\) with .*Dotenv.* will always evaluate to true\.$#'
            path: tests/bootstrap.php
