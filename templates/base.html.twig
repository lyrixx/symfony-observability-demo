{% import '_ui.html.twig' as ui %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><path d=%22M8 16h16M8 16C16 16 15 6 24 6M8 16C16 16 15 26 24 26%22 fill=%22none%22 stroke=%22%23ff8833%22 stroke-width=%222.6%22 stroke-linecap=%22round%22/><g fill=%22%23ff8833%22><circle cx=%226%22 cy=%2216%22 r=%223.6%22/><circle cx=%2226%22 cy=%226%22 r=%223%22/><circle cx=%2226%22 cy=%2216%22 r=%223%22/><circle cx=%2226%22 cy=%2226%22 r=%223%22/></g></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="obs-topbar">
            <button class="obs-topbar-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#obs-menu" aria-controls="obs-menu" aria-label="Toggle navigation">
                {{ ui.icon('menu') }}
            </button>
            <a class="obs-brand" href="{{ path('homepage') }}">
                <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                    <defs>
                        <linearGradient id="obs-logo" x1="0" y1="1" x2="1" y2="0">
                            <stop stop-color="#f55f3e" />
                            <stop offset="1" stop-color="#f9c22b" />
                        </linearGradient>
                    </defs>
                    <path d="M8 16h16M8 16C16 16 15 6 24 6M8 16C16 16 15 26 24 26" fill="none" stroke="url(#obs-logo)" stroke-width="2.6" stroke-linecap="round" />
                    <g fill="url(#obs-logo)">
                        <circle cx="6" cy="16" r="3.6" />
                        <circle cx="26" cy="6" r="3" />
                        <circle cx="26" cy="16" r="3" />
                        <circle cx="26" cy="26" r="3" />
                    </g>
                </svg>
                <span>Observability Demo</span>
            </a>
            <nav class="obs-breadcrumb d-none d-md-block" aria-label="Breadcrumb">
                <a href="{{ path('homepage') }}">Home</a>
                <span aria-current="page">{% block breadcrumb %}{{ block('title') }}{% endblock %}</span>
            </nav>
            <div class="obs-topbar-links">
                <a href="https://github.com/lyrixx/symfony-observability-demo" target="_blank" rel="noopener">{{ ui.icon('github') }}<span class="d-none d-sm-inline">GitHub</span></a>
                <a href="https://s.lyrixx.info/log" target="_blank" rel="noopener">{{ ui.icon('slides') }}<span class="d-none d-sm-inline">Slides</span></a>
            </div>
        </header>

        <div class="obs-toasts" role="status" aria-live="polite">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="obs-shell">
            <div class="obs-sidebar">
                <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="obs-menu" aria-label="Navigation">
                    <div class="offcanvas-header d-lg-none">
                        <span class="obs-nav-title m-0">Menu</span>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#obs-menu" aria-label="Close"></button>
                    </div>
                    <nav class="offcanvas-body d-block" aria-label="Main">
                        <ul class="obs-nav">
                            <li><a class="obs-nav-link {{ app.current_route == 'homepage' ? 'active' }}" href="{{ path('homepage') }}">{{ ui.icon('overview') }}Overview</a></li>
                            <li><a class="obs-nav-link {{ app.current_route == 'logs' ? 'active' }}" href="{{ path('logs') }}">{{ ui.icon('logs') }}Generate logs</a></li>
                            <li><a class="obs-nav-link" href="{{ path('exception') }}">{{ ui.icon('exception') }}Generate exception</a></li>
                        </ul>

                        <p class="obs-nav-title">Explore</p>
                        <ul class="obs-nav">
                            <li><a class="obs-nav-link" href="{{ ui.tool_url('kibana') }}">{{ ui.icon('dashboard') }}Kibana</a></li>
                            <li><a class="obs-nav-link" href="{{ ui.tool_url('grafana') }}">{{ ui.icon('dashboard') }}Grafana</a></li>
                            <li><a class="obs-nav-link" href="{{ ui.tool_url('redash') }}">{{ ui.icon('dashboard') }}Redash</a></li>
                            <li><a class="obs-nav-link" href="{{ ui.tool_url('vector') }}">{{ ui.icon('pipeline') }}Vector</a></li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div class="obs-content">
                <main class="obs-main">
                    {% block body %}{% endblock %}
                </main>

                <footer class="obs-footer">
                    Built to demonstrate how to configure Monolog with Symfony &mdash;
                    <a href="https://s.lyrixx.info/log">slides (in French)</a>
                </footer>
            </div>
        </div>
    </body>
</html>
