{% extends 'base.html.twig' %}

{% block title %}Observability Demo Application{% endblock %}

{% block body %}
    <div class="bg-body-tertiary border-bottom">
        <div class="container py-5 text-center">
            <h1 class="display-5 fw-bold">{{ block('title') }}</h1>
            <p class="col-lg-8 mx-auto lead">
                This application demonstrates how to configure Monolog with Symfony.
                Every log record is sent to
                <a href="https://vector.dev/" title="An application that collects and re-dispatches logs">Vector</a>,
                which fans it out to ClickHouse, Elasticsearch and Loki.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="{{ path('logs') }}" class="btn btn-primary btn-lg">Generate logs</a>
                <a href="{{ path('exception') }}" class="btn btn-outline-danger btn-lg">Generate an exception</a>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <h2 class="h4 mb-4">Explore the collected logs</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title h5">Kibana</h3>
                        <p class="card-text text-body-secondary">Pre-built dashboard over Elasticsearch logs.</p>
                        <a href="https://kibana.{{ app.request.host }}/app/dashboards#/view/observability-overview" class="mt-auto">Open dashboard &raquo;</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title h5">Grafana</h3>
                        <p class="card-text text-body-secondary">Pre-built dashboard over Loki and ClickHouse logs.</p>
                        <a href="https://grafana.{{ app.request.host }}/d/observability-overview" class="mt-auto">Open dashboard &raquo;</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title h5">Redash</h3>
                        <p class="card-text text-body-secondary">
                            Pre-built dashboard over ClickHouse logs. Login:
                            <code>admin@observability.test</code> / <code>observability</code>.
                        </p>
                        <a href="https://redash.{{ app.request.host }}/dashboard/observability-overview" class="mt-auto">Open dashboard &raquo;</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title h5">Vector</h3>
                        <p class="card-text text-body-secondary">Inspect the log collection pipeline itself.</p>
                        <a href="https://vector.{{ app.request.host }}/playground" class="mt-auto">Open playground &raquo;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
